    <!-- PROJECT 1: Smart Trolley -->
    <div class="project-full reveal">
      <div class="pf-screenshot">
        <div class="vsc-window">
          <div class="vsc-titlebar"><div class="vsc-dots"><span class="vd r"></span><span class="vd y"></span><span class="vd g"></span></div><span class="vsc-title">rfid_scanner.py — smart-trolley</span></div>
          <div class="vsc-body">
            <div class="vsc-sidebar">
              <div class="vsc-dir">SMART-TROLLEY</div>
              <div class="vsc-file active-file"><i class="fa-solid fa-circle" style="color:#00d9ff;font-size:.4rem"></i>&nbsp;rfid_scanner.py</div>
              <div class="vsc-file">cart_manager.py</div>
              <div class="vsc-file">display_lcd.py</div>
              <div class="vsc-file dim">&nbsp;&#128193; database/</div>
              <div class="vsc-file dim">&nbsp;&nbsp;&nbsp;products.db</div>
              <div class="vsc-file">requirements.txt</div>
            </div>
            <div class="vsc-editor">
              <div class="vsc-linenums"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span><span>11</span><span>12</span><span>13</span><span>14</span><span>15</span></div>
              <div class="vsc-code">
                <div class="cl"><span class="ck">import</span> <span class="cm">RPi.GPIO</span> <span class="ck">as</span> <span class="cm">GPIO</span></div>
                <div class="cl"><span class="ck">from</span> <span class="cm">mfrc522</span> <span class="ck">import</span> <span class="cm">SimpleMFRC522</span></div>
                <div class="cl"><span class="ck">import</span> <span class="cm">sqlite3</span><span class="cpunc">,</span> <span class="cm">time</span></div>
                <div class="cl">&nbsp;</div>
                <div class="cl"><span class="cf">reader</span> <span class="cpunc">=</span> <span class="cm">SimpleMFRC522</span><span class="cpunc">()</span></div>
                <div class="cl"><span class="cf">cart</span> <span class="cpunc">= []</span></div>
                <div class="cl">&nbsp;</div>
                <div class="cl"><span class="ck">def</span> <span class="cfn">scan_item</span><span class="cpunc">():</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ck">try</span><span class="cpunc">:</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cf">uid</span><span class="cpunc">,</span> <span class="cf">_</span> <span class="cpunc">=</span> <span class="cf">reader</span><span class="cpunc">.</span><span class="cfn">read</span><span class="cpunc">()</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cf">product</span> <span class="cpunc">=</span> <span class="cfn">db_lookup</span><span class="cpunc">(</span><span class="cf">uid</span><span class="cpunc">)</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cf">cart</span><span class="cpunc">.</span><span class="cfn">append</span><span class="cpunc">(</span><span class="cf">product</span><span class="cpunc">)</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cfn">update_display</span><span class="cpunc">(</span><span class="cf">cart</span><span class="cpunc">)</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ck">finally</span><span class="cpunc">:</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cm">GPIO</span><span class="cpunc">.</span><span class="cfn">cleanup</span><span class="cpunc">()</span></div>
              </div>
            </div>
          </div>
          <div class="vsc-terminal">
            <div class="term-tabs"><span class="term-tab active-tt">TERMINAL</span><span class="term-tab">OUTPUT</span></div>
            <div class="term-body">
              <div class="tl"><span class="tp">pi@raspberrypi:~/smart-trolley $</span> python3 rfid_scanner.py</div>
              <div class="tl"><span class="ts">&#10003;</span> RFID reader initialised on SPI0 — 48 products loaded</div>
              <div class="tl"><span class="tw">Waiting for RFID scan...</span></div>
              <div class="tl"><span class="ty">&#8594;</span> Scanned 3A:F2:01 — Milk 2L $3.50 | Total: $3.50</div>
              <div class="tl"><span class="ty">&#8594;</span> Scanned B1:C4:22 — Bread $3.00 | Total: $6.50</div>
              <div class="tl tcursor">&#9612;</div>
            </div>
          </div>
        </div>
      </div>
      <div class="pf-info">
        <div class="pf-num">01 / IoT &middot; Python &middot; Hardware</div>
        <h2 class="pf-title">Smart Trolley System</h2>
        <p class="pf-desc">An IoT-powered trolley using RFID scanning on Raspberry Pi. Python reads tag UIDs, queries a SQLite product database, tracks totals in real time, and updates an LCD display — letting shoppers skip the checkout queue entirely.</p>
        <div class="pf-impact">
          <div class="impact-item"><span class="impact-val">40%</span><span class="impact-key">Checkout Time Saved</span></div>
          <div class="impact-item"><span class="impact-val">48</span><span class="impact-key">Products in DB</span></div>
        </div>
        <div class="pf-tech"><span>Python</span><span>Raspberry Pi</span><span>Arduino</span><span>RFID</span><span>SQLite</span><span>GPIO</span></div>
        <div class="pf-links">
          <a href="https://github.com/lalitgonji" target="_blank" class="pf-link"><i class="fa-brands fa-github"></i> GitHub</a>
          <a href="#" class="pf-link pf-link-demo"><i class="fa-solid fa-play"></i> Watch Demo</a>
        </div>
      </div>
    </div>

    <!-- PROJECT 2: Roadside App -->
    <div class="project-full reverse reveal">
      <div class="pf-screenshot">
        <div class="vsc-window">
          <div class="vsc-titlebar"><div class="vsc-dots"><span class="vd r"></span><span class="vd y"></span><span class="vd g"></span></div><span class="vsc-title">MainActivity.java — RoadsideAssist</span></div>
          <div class="vsc-body">
            <div class="vsc-sidebar">
              <div class="vsc-dir">APP / JAVA</div>
              <div class="vsc-file active-file"><i class="fa-solid fa-circle" style="color:#00d9ff;font-size:.4rem"></i>&nbsp;MainActivity.java</div>
              <div class="vsc-file">MapsActivity.java</div>
              <div class="vsc-file">ProviderModel.java</div>
              <div class="vsc-file">FirebaseHelper.java</div>
              <div class="vsc-dir" style="margin-top:6px">RES / LAYOUT</div>
              <div class="vsc-file">activity_main.xml</div>
              <div class="vsc-file">activity_maps.xml</div>
            </div>
            <div class="vsc-editor">
              <div class="vsc-linenums"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span><span>11</span><span>12</span><span>13</span><span>14</span><span>15</span></div>
              <div class="vsc-code">
                <div class="cl"><span class="ck">public class</span> <span class="cm">MainActivity</span> <span class="ck">extends</span> <span class="cm">AppCompatActivity</span> <span class="cpunc">{</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ck">private</span> <span class="cm">FusedLocationClient</span> <span class="cf">locationClient</span><span class="cpunc">;</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ck">private</span> <span class="cm">DatabaseReference</span> <span class="cf">dbRef</span><span class="cpunc">;</span></div>
                <div class="cl">&nbsp;</div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ca">@Override</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ck">protected void</span> <span class="cfn">onCreate</span><span class="cpunc">(</span><span class="cm">Bundle</span> <span class="cf">b</span><span class="cpunc">) {</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cfn">setContentView</span><span class="cpunc">(</span><span class="cm">R</span><span class="cpunc">.</span><span class="cf">layout</span><span class="cpunc">.</span><span class="cf">activity_main</span><span class="cpunc">);</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cf">dbRef</span> <span class="cpunc">=</span> <span class="cm">FirebaseDatabase</span><span class="cpunc">.</span><span class="cfn">getInstance</span><span class="cpunc">().</span><span class="cfn">getReference</span><span class="cpunc">(</span><span class="cs">"providers"</span><span class="cpunc">);</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cf">locationClient</span> <span class="cpunc">=</span> <span class="cm">LocationServices</span><span class="cpunc">.</span><span class="cfn">getFusedLocationProviderClient</span><span class="cpunc">(</span><span class="ck">this</span><span class="cpunc">);</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cfn">fetchNearbyProviders</span><span class="cpunc">();</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="cpunc">}</span></div>
                <div class="cl">&nbsp;</div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ck">private void</span> <span class="cfn">fetchNearbyProviders</span><span class="cpunc">() {</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="ccomment">// Geo-query Firebase for 5km radius</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cf">dbRef</span><span class="cpunc">.</span><span class="cfn">addValueEventListener</span><span class="cpunc">(</span><span class="cfn">providerListener</span><span class="cpunc">);</span></div>
              </div>
            </div>
          </div>
          <div class="vsc-terminal">
            <div class="term-tabs"><span class="term-tab active-tt">BUILD</span><span class="term-tab">LOGCAT</span></div>
            <div class="term-body">
              <div class="tl"><span class="ts">BUILD SUCCESSFUL</span> in 4s &mdash; 42 actionable tasks</div>
              <div class="tl"><span class="ty">D/Firebase:</span> Realtime Database connected</div>
              <div class="tl"><span class="ty">D/Location:</span> GPS fix &mdash; Lat: -33.8688, Lng: 151.2093</div>
              <div class="tl"><span class="ts">D/Providers:</span> 3 providers found within 5km</div>
              <div class="tl tcursor">&#9612;</div>
            </div>
          </div>
        </div>
      </div>
      <div class="pf-info">
        <div class="pf-num">02 / Android &middot; Java &middot; Firebase</div>
        <h2 class="pf-title">Roadside Assistance App</h2>
        <p class="pf-desc">Android app in Java connecting stranded drivers to the nearest providers within 5km. Uses Firebase Realtime Database for live updates, Google Maps API for routing, and FusedLocationProvider for accurate GPS. Built and tested in Android Studio.</p>
        <div class="pf-impact">
          <div class="impact-item"><span class="impact-val">5km</span><span class="impact-key">Search Radius</span></div>
          <div class="impact-item"><span class="impact-val">Real-time</span><span class="impact-key">Firebase Sync</span></div>
        </div>
        <div class="pf-tech"><span>Java</span><span>Android Studio</span><span>Firebase</span><span>Google Maps API</span><span>GPS</span></div>
        <div class="pf-links">
          <a href="https://github.com/lalitgonji" target="_blank" class="pf-link"><i class="fa-brands fa-github"></i> GitHub</a>
          <a href="#" class="pf-link pf-link-demo"><i class="fa-solid fa-mobile-screen"></i> Download APK</a>
        </div>
      </div>
    </div>

    <!-- PROJECT 3: TaskFlow Spring Boot -->
    <div class="project-full reveal">
      <div class="pf-screenshot">
        <div class="vsc-window">
          <div class="vsc-titlebar"><div class="vsc-dots"><span class="vd r"></span><span class="vd y"></span><span class="vd g"></span></div><span class="vsc-title">TaskController.java — taskflow-api</span></div>
          <div class="vsc-body">
            <div class="vsc-sidebar">
              <div class="vsc-dir">SRC / MAIN / JAVA</div>
              <div class="vsc-file active-file"><i class="fa-solid fa-circle" style="color:#00d9ff;font-size:.4rem"></i>&nbsp;TaskController.java</div>
              <div class="vsc-file">TaskService.java</div>
              <div class="vsc-file">Task.java</div>
              <div class="vsc-file">User.java</div>
              <div class="vsc-file">JwtFilter.java</div>
              <div class="vsc-file">TaskRepository.java</div>
              <div class="vsc-dir" style="margin-top:6px">RESOURCES</div>
              <div class="vsc-file">application.yml</div>
            </div>
            <div class="vsc-editor">
              <div class="vsc-linenums"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span><span>11</span><span>12</span><span>13</span><span>14</span><span>15</span></div>
              <div class="vsc-code">
                <div class="cl"><span class="ca">@RestController</span></div>
                <div class="cl"><span class="ca">@RequestMapping</span><span class="cpunc">(</span><span class="cs">"/api/tasks"</span><span class="cpunc">)</span></div>
                <div class="cl"><span class="ck">public class</span> <span class="cm">TaskController</span> <span class="cpunc">{</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ca">@Autowired</span> <span class="ck">private</span> <span class="cm">TaskService</span> <span class="cf">taskService</span><span class="cpunc">;</span></div>
                <div class="cl">&nbsp;</div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ca">@GetMapping</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ck">public</span> <span class="cm">ResponseEntity</span><span class="cpunc">&lt;</span><span class="cm">List</span><span class="cpunc">&lt;</span><span class="cm">Task</span><span class="cpunc">&gt;&gt;</span> <span class="cfn">getAll</span><span class="cpunc">() {</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="ck">return</span> <span class="cm">ResponseEntity</span><span class="cpunc">.</span><span class="cfn">ok</span><span class="cpunc">(</span><span class="cf">taskService</span><span class="cpunc">.</span><span class="cfn">findAll</span><span class="cpunc">());</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="cpunc">}</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ca">@PostMapping</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ck">public</span> <span class="cm">ResponseEntity</span><span class="cpunc">&lt;</span><span class="cm">Task</span><span class="cpunc">&gt;</span> <span class="cfn">create</span><span class="cpunc">(</span><span class="ca">@RequestBody</span> <span class="cm">Task</span> <span class="cf">t</span><span class="cpunc">) {</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="ck">return</span> <span class="cm">ResponseEntity</span><span class="cpunc">.</span><span class="cfn">status</span><span class="cpunc">(</span><span class="cnum">201</span><span class="cpunc">).</span><span class="cfn">body</span><span class="cpunc">(</span><span class="cf">taskService</span><span class="cpunc">.</span><span class="cfn">save</span><span class="cpunc">(</span><span class="cf">t</span><span class="cpunc">));</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="cpunc">}</span></div>
                <div class="cl"><span class="cpunc">}</span></div>
              </div>
            </div>
          </div>
          <div class="vsc-terminal">
            <div class="term-tabs"><span class="term-tab active-tt">TERMINAL</span><span class="term-tab">SPRING</span></div>
            <div class="term-body">
              <div class="tl"><span class="ts">Started TaskflowApplication</span> in 2.341s (JVM 17.0.9)</div>
              <div class="tl"><span class="tw">Tomcat started on port(s): 8080</span></div>
              <div class="tl"><span class="ty">GET</span> /api/tasks &mdash; 200 OK (12ms) &mdash; 9 tasks</div>
              <div class="tl"><span class="ts">POST</span> /api/tasks &mdash; 201 Created &mdash; "Deploy to AWS"</div>
              <div class="tl tcursor">&#9612;</div>
            </div>
          </div>
        </div>
      </div>
      <div class="pf-info">
        <div class="pf-num">03 / Full Stack &middot; Spring Boot &middot; React</div>
        <h2 class="pf-title">TaskFlow &mdash; Project Management App</h2>
        <p class="pf-desc">Full-stack Kanban app with a Spring Boot REST API backend using JWT auth, JPA/Hibernate with MySQL, and a React frontend with drag-and-drop boards and WebSocket live updates. Containerised with Docker for easy deployment.</p>
        <div class="pf-impact">
          <div class="impact-item"><span class="impact-val">REST</span><span class="impact-key">Spring Boot API</span></div>
          <div class="impact-item"><span class="impact-val">JWT</span><span class="impact-key">Secure Auth</span></div>
        </div>
        <div class="pf-tech"><span>Java</span><span>Spring Boot</span><span>React</span><span>MySQL</span><span>JWT</span><span>Docker</span></div>
        <div class="pf-links">
          <a href="https://github.com/lalitgonji" target="_blank" class="pf-link"><i class="fa-brands fa-github"></i> GitHub</a>
          <a href="#" class="pf-link pf-link-demo"><i class="fa-solid fa-arrow-up-right-from-square"></i> Live Demo</a>
        </div>
      </div>
    </div>

    <!-- PROJECT 4: ShopNest AWS -->
    <div class="project-full reverse reveal">
      <div class="pf-screenshot">
        <div class="vsc-window">
          <div class="vsc-titlebar"><div class="vsc-dots"><span class="vd r"></span><span class="vd y"></span><span class="vd g"></span></div><span class="vsc-title">S3UploadService.java &mdash; shopnest &middot; EC2</span></div>
          <div class="vsc-body">
            <div class="vsc-sidebar">
              <div class="vsc-dir">SRC / SERVICE</div>
              <div class="vsc-file active-file"><i class="fa-solid fa-circle" style="color:#f59e0b;font-size:.4rem"></i>&nbsp;S3UploadService.java</div>
              <div class="vsc-file">ProductService.java</div>
              <div class="vsc-file">OrderService.java</div>
              <div class="vsc-file">PaymentService.java</div>
              <div class="vsc-dir" style="margin-top:6px">DOCKER</div>
              <div class="vsc-file">Dockerfile</div>
              <div class="vsc-file">docker-compose.yml</div>
            </div>
            <div class="vsc-editor">
              <div class="vsc-linenums"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span><span>11</span><span>12</span><span>13</span></div>
              <div class="vsc-code">
                <div class="cl"><span class="ca">@Service</span></div>
                <div class="cl"><span class="ck">public class</span> <span class="cm">S3UploadService</span> <span class="cpunc">{</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ck">private final</span> <span class="cm">AmazonS3</span> <span class="cf">s3Client</span><span class="cpunc">;</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ck">private final</span> <span class="cm">String</span> <span class="cf">bucket</span> <span class="cpunc">=</span> <span class="cs">"shopnest-images"</span><span class="cpunc">;</span></div>
                <div class="cl">&nbsp;</div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ck">public</span> <span class="cm">String</span> <span class="cfn">uploadImage</span><span class="cpunc">(</span><span class="cm">MultipartFile</span> <span class="cf">file</span><span class="cpunc">) {</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cm">String</span> <span class="cf">key</span> <span class="cpunc">=</span> <span class="cm">UUID</span><span class="cpunc">.</span><span class="cfn">randomUUID</span><span class="cpunc">() +</span> <span class="cs">".jpg"</span><span class="cpunc">;</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cf">s3Client</span><span class="cpunc">.</span><span class="cfn">putObject</span><span class="cpunc">(</span><span class="cf">bucket</span><span class="cpunc">,</span> <span class="cf">key</span><span class="cpunc">,</span> <span class="cf">file</span><span class="cpunc">.</span><span class="cfn">getInputStream</span><span class="cpunc">(),</span> <span class="ck">new</span> <span class="cm">ObjectMetadata</span><span class="cpunc">());</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="ck">return</span> <span class="cs">"https://shopnest-images.s3.ap-southeast-2.amazonaws.com/"</span> <span class="cpunc">+</span> <span class="cf">key</span><span class="cpunc">;</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="cpunc">}</span></div>
                <div class="cl"><span class="cpunc">}</span></div>
              </div>
            </div>
          </div>
          <div class="vsc-terminal">
            <div class="term-tabs"><span class="term-tab active-tt">EC2 TERMINAL</span><span class="term-tab">DOCKER</span></div>
            <div class="term-body">
              <div class="tl"><span class="tp">ubuntu@ec2-13-54-112:~/shopnest $</span> docker-compose up -d</div>
              <div class="tl"><span class="ts">&#10003;</span> Container shopnest-db started</div>
              <div class="tl"><span class="ts">&#10003;</span> Container shopnest-api started on :8080</div>
              <div class="tl"><span class="ts">&#10003;</span> Container shopnest-frontend on :3000</div>
              <div class="tl"><span class="tw">S3 bucket ready &mdash; shopnest-images (ap-southeast-2)</span></div>
              <div class="tl tcursor">&#9612;</div>
            </div>
          </div>
        </div>
      </div>
      <div class="pf-info">
        <div class="pf-num">04 / E-Commerce &middot; AWS &middot; Docker</div>
        <h2 class="pf-title">ShopNest &mdash; E-Commerce Platform</h2>
        <p class="pf-desc">Cloud-native e-commerce with product catalogue, cart, and Stripe payment. Spring Boot API containerised with Docker and deployed on AWS EC2. Product images stored in AWS S3. CI/CD via GitHub Actions auto-deploys on every push.</p>
        <div class="pf-impact">
          <div class="impact-item"><span class="impact-val">AWS</span><span class="impact-key">EC2 + S3</span></div>
          <div class="impact-item"><span class="impact-val">Docker</span><span class="impact-key">Containerised</span></div>
        </div>
        <div class="pf-tech"><span>Spring Boot</span><span>React</span><span>MySQL</span><span>AWS EC2</span><span>AWS S3</span><span>Docker</span><span>Stripe</span></div>
        <div class="pf-links">
          <a href="https://github.com/lalitgonji" target="_blank" class="pf-link"><i class="fa-brands fa-github"></i> GitHub</a>
          <a href="#" class="pf-link pf-link-demo"><i class="fa-solid fa-arrow-up-right-from-square"></i> Live Demo</a>
        </div>
      </div>
    </div>

    <!-- PROJECT 5: Chat App Node.js -->
    <div class="project-full reveal">
      <div class="pf-screenshot">
        <div class="vsc-window">
          <div class="vsc-titlebar"><div class="vsc-dots"><span class="vd r"></span><span class="vd y"></span><span class="vd g"></span></div><span class="vsc-title">server.js &mdash; connectchat</span></div>
          <div class="vsc-body">
            <div class="vsc-sidebar">
              <div class="vsc-dir">CONNECTCHAT</div>
              <div class="vsc-file active-file"><i class="fa-solid fa-circle" style="color:#22c55e;font-size:.4rem"></i>&nbsp;server.js</div>
              <div class="vsc-file">socket.js</div>
              <div class="vsc-file">authMiddleware.js</div>
              <div class="vsc-file dim">&#128193; models/</div>
              <div class="vsc-file">Message.js</div>
              <div class="vsc-file">User.js</div>
              <div class="vsc-file dim">&#128193; routes/</div>
              <div class="vsc-file">chat.routes.js</div>
            </div>
            <div class="vsc-editor">
              <div class="vsc-linenums"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span><span>11</span><span>12</span><span>13</span><span>14</span><span>15</span></div>
              <div class="vsc-code">
                <div class="cl"><span class="ck">const</span> <span class="cf">io</span> <span class="cpunc">=</span> <span class="cfn">require</span><span class="cpunc">(</span><span class="cs">'socket.io'</span><span class="cpunc">)(</span><span class="cf">server</span><span class="cpunc">, {</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="cf">cors</span><span class="cpunc">: {</span> <span class="cf">origin</span><span class="cpunc">:</span> <span class="cs">'*'</span> <span class="cpunc">}</span></div>
                <div class="cl"><span class="cpunc">});</span></div>
                <div class="cl">&nbsp;</div>
                <div class="cl"><span class="cf">io</span><span class="cpunc">.</span><span class="cfn">on</span><span class="cpunc">(</span><span class="cs">'connection'</span><span class="cpunc">,</span> <span class="cpunc">(</span><span class="cf">socket</span><span class="cpunc">) =&gt; {</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="cf">socket</span><span class="cpunc">.</span><span class="cfn">on</span><span class="cpunc">(</span><span class="cs">'sendMessage'</span><span class="cpunc">,</span> <span class="ck">async</span> <span class="cpunc">(</span><span class="cf">data</span><span class="cpunc">) =&gt; {</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="ck">const</span> <span class="cf">msg</span> <span class="cpunc">=</span> <span class="ck">await</span> <span class="cm">Message</span><span class="cpunc">.</span><span class="cfn">create</span><span class="cpunc">(</span><span class="cf">data</span><span class="cpunc">);</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cf">io</span><span class="cpunc">.</span><span class="cfn">to</span><span class="cpunc">(</span><span class="cf">data</span><span class="cpunc">.</span><span class="cf">roomId</span><span class="cpunc">).</span><span class="cfn">emit</span><span class="cpunc">(</span><span class="cs">'newMessage'</span><span class="cpunc">,</span> <span class="cf">msg</span><span class="cpunc">);</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="cpunc">});</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="cf">socket</span><span class="cpunc">.</span><span class="cfn">on</span><span class="cpunc">(</span><span class="cs">'disconnect'</span><span class="cpunc">,</span> <span class="cpunc">() =&gt;</span> <span class="cfn">setOffline</span><span class="cpunc">(</span><span class="cf">socket</span><span class="cpunc">.</span><span class="cf">id</span><span class="cpunc">));</span></div>
                <div class="cl"><span class="cpunc">});</span></div>
                <div class="cl">&nbsp;</div>
                <div class="cl"><span class="cf">server</span><span class="cpunc">.</span><span class="cfn">listen</span><span class="cpunc">(</span><span class="cnum">5000</span><span class="cpunc">,</span> <span class="cpunc">() =&gt;</span> <span class="cfn">console</span><span class="cpunc">.</span><span class="cfn">log</span><span class="cpunc">(</span><span class="cs">'Server on :5000'</span><span class="cpunc">));</span></div>
              </div>
            </div>
          </div>
          <div class="vsc-terminal">
            <div class="term-tabs"><span class="term-tab active-tt">TERMINAL</span><span class="term-tab">DEBUG</span></div>
            <div class="term-body">
              <div class="tl"><span class="tp">~/connectchat $</span> node server.js</div>
              <div class="tl"><span class="ts">&#10003;</span> MongoDB connected &mdash; cluster0.mongodb.net</div>
              <div class="tl"><span class="ts">&#10003;</span> Server running on :5000</div>
              <div class="tl"><span class="ty">socket:</span> User connected xK2mPq &mdash; lalit@gmail.com</div>
              <div class="tl"><span class="ty">socket:</span> Message #general delivered (87ms)</div>
              <div class="tl tcursor">&#9612;</div>
            </div>
          </div>
        </div>
      </div>
      <div class="pf-info">
        <div class="pf-num">05 / Real-time &middot; Node.js &middot; Socket.IO</div>
        <h2 class="pf-title">ConnectChat &mdash; Real-time Chat App</h2>
        <p class="pf-desc">Real-time messaging with private and group rooms, online presence indicators, and read receipts. Node.js + Socket.IO backend persisting to MongoDB via Mongoose. JWT middleware protects routes. React frontend with live socket listeners for instant delivery.</p>
        <div class="pf-impact">
          <div class="impact-item"><span class="impact-val">&lt;90ms</span><span class="impact-key">Avg Latency</span></div>
          <div class="impact-item"><span class="impact-val">Rooms</span><span class="impact-key">Group + Private</span></div>
        </div>
        <div class="pf-tech"><span>Node.js</span><span>Socket.IO</span><span>React</span><span>MongoDB</span><span>JWT</span><span>Express</span></div>
        <div class="pf-links">
          <a href="https://github.com/lalitgonji" target="_blank" class="pf-link"><i class="fa-brands fa-github"></i> GitHub</a>
          <a href="#" class="pf-link pf-link-demo"><i class="fa-solid fa-arrow-up-right-from-square"></i> Live Demo</a>
        </div>
      </div>
    </div>

    <!-- PROJECT 6: DataInsight Lambda -->
    <div class="project-full reverse reveal">
      <div class="pf-screenshot">
        <div class="vsc-window">
          <div class="vsc-titlebar"><div class="vsc-dots"><span class="vd r"></span><span class="vd y"></span><span class="vd g"></span></div><span class="vsc-title">MetricsHandler.java &mdash; datainsight-lambda</span></div>
          <div class="vsc-body">
            <div class="vsc-sidebar">
              <div class="vsc-dir">LAMBDA / SRC</div>
              <div class="vsc-file active-file"><i class="fa-solid fa-circle" style="color:#a78bfa;font-size:.4rem"></i>&nbsp;MetricsHandler.java</div>
              <div class="vsc-file">AggregatorService.java</div>
              <div class="vsc-file">S3EventProcessor.java</div>
              <div class="vsc-file dim">&#128193; frontend/src</div>
              <div class="vsc-file">Dashboard.jsx</div>
              <div class="vsc-file">ChartWidget.jsx</div>
              <div class="vsc-file dim">template.yaml</div>
              <div class="vsc-file dim">samconfig.toml</div>
            </div>
            <div class="vsc-editor">
              <div class="vsc-linenums"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span><span>11</span><span>12</span><span>13</span></div>
              <div class="vsc-code">
                <div class="cl"><span class="ck">public class</span> <span class="cm">MetricsHandler</span> <span class="ck">implements</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cm">RequestHandler</span><span class="cpunc">&lt;</span><span class="cm">APIGatewayProxyRequestEvent</span><span class="cpunc">,</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cm">APIGatewayProxyResponseEvent</span><span class="cpunc">&gt; {</span></div>
                <div class="cl">&nbsp;</div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="ck">public</span> <span class="cm">APIGatewayProxyResponseEvent</span> <span class="cfn">handleRequest</span><span class="cpunc">(</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cm">APIGatewayProxyRequestEvent</span> <span class="cf">event</span><span class="cpunc">,</span> <span class="cm">Context</span> <span class="cf">ctx</span><span class="cpunc">) {</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cm">Map</span><span class="cpunc">&lt;</span><span class="cm">String</span><span class="cpunc">,</span><span class="cm">Object</span><span class="cpunc">&gt;</span> <span class="cf">metrics</span> <span class="cpunc">=</span> <span class="cfn">aggregateMetrics</span><span class="cpunc">();</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="ck">return</span> <span class="ck">new</span> <span class="cm">APIGatewayProxyResponseEvent</span><span class="cpunc">()</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cpunc">.</span><span class="cfn">withStatusCode</span><span class="cpunc">(</span><span class="cnum">200</span><span class="cpunc">)</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cpunc">.</span><span class="cfn">withBody</span><span class="cpunc">(</span><span class="cf">gson</span><span class="cpunc">.</span><span class="cfn">toJson</span><span class="cpunc">(</span><span class="cf">metrics</span><span class="cpunc">))</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="cpunc">.</span><span class="cfn">withHeaders</span><span class="cpunc">(</span><span class="cfn">corsHeaders</span><span class="cpunc">());</span></div>
                <div class="cl"><span class="ci">&nbsp;&nbsp;</span><span class="cpunc">}</span></div>
              </div>
            </div>
          </div>
          <div class="vsc-terminal">
            <div class="term-tabs"><span class="term-tab active-tt">SAM CLI</span><span class="term-tab">CLOUDWATCH</span></div>
            <div class="term-body">
              <div class="tl"><span class="tp">~/datainsight $</span> sam deploy --guided</div>
              <div class="tl"><span class="ts">&#10003;</span> Stack CREATE_COMPLETE &mdash; datainsight-prod</div>
              <div class="tl"><span class="ts">&#10003;</span> Lambda MetricsHandler deployed &mdash; ap-southeast-2</div>
              <div class="tl"><span class="tw">API:</span> https://x9a2b.execute-api.ap-southeast-2.amazonaws.com/prod</div>
              <div class="tl"><span class="ty">INVOKE:</span> GET /metrics &mdash; 200 OK (143ms cold start)</div>
              <div class="tl tcursor">&#9612;</div>
            </div>
